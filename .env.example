# Google Sheets API 설정
# Service Account JSON 키 전체를 한 줄로 입력 (JSON 문자열)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Google Sheets 스프레드시트 ID
# 스프레드시트 URL에서 추출: https://docs.google.com/spreadsheets/d/[SPREADSHEET_ID]/edit
GOOGLE_SHEET_ID=your-spreadsheet-id-here

# Supabase 설정
# Supabase 프로젝트 대시보드 > Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 관리자 인증 (간단한 비밀번호 방식)
ADMIN_PASSWORD=your-secure-password-here

# Supabase Service Role Key (관리자 전용, 절대 공개하지 마세요!)
SUPABASE_SERVICE_ROLE_KEY=service-role-key